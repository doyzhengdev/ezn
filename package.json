{
  "name": "@doyzheng/ezn",
  "version": "0.0.8",
  "description": "在项目固定版本的托管 Node 上执行任意命令：按需下载/落位 Node 运行时，零系统依赖（npx nve 22 的替代）",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "ezn": "bin/ezn.js"
  },
  "engines": {
    "node": ">=16"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "node",
    "nodejs",
    "runtime",
    "version-manager",
    "node-version",
    "pinned-version",
    "nvm",
    "nve",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doyzhengdev/ezn.git"
  },
  "homepage": "https://github.com/doyzhengdev/ezn#readme",
  "bugs": {
    "url": "https://github.com/doyzhengdev/ezn/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.mts",
    "typecheck": "tsc",
    "update-assets": "tsx scripts/update-node-assets.mts",
    "test": "tsx scripts/build.mts && npx vitest run",
    "release": "tsx scripts/release.mts"
  },
  "dependencies": {
    "got": "^11.8.6",
    "tar": "^6.2.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^3.4.0",
    "prettier": "^3.9.8",
    "rolldown-plugin-dts": "^0.28.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
